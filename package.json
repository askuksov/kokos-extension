{
  "name": "kokos-extension",
  "version": "0.1.0",
  "description": "Save and autofill logins from the Kokos password manager.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^2.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
